# Copy this file to tests/e2e/.env and fill in the Dev credential values.
DOUBAO_RUN_LIVE=1
DOUBAO_ASR_APP_ID=
DOUBAO_ASR_API_KEY=
DOUBAO_ASR_RESOURCE_ID=volc.bigasr.sauc.duration

# Optional paid Podcast generation test. DOUBAO_API_KEY is accepted as fallback.
DOUBAO_PODCAST_APP_ID=
DOUBAO_PODCAST_API_KEY=
DOUBAO_PODCAST_RESOURCE_ID=volc.service_type.10050

# Optional realtime dialogue output-modality test. DOUBAO_APP_ID/DOUBAO_API_KEY
# are accepted as fallback. Speakers default to public O20/SC20 voices.
DOUBAO_REALTIME_APP_ID=
DOUBAO_REALTIME_API_KEY=
DOUBAO_REALTIME_RESOURCE_ID=volc.speech.dialog
DOUBAO_REALTIME_O20_SPEAKER=
DOUBAO_REALTIME_SC20_SPEAKER=
# Optional enterprise-provisioned scene ID sent as dialog.extra.scene_id.
DOUBAO_REALTIME_SCENE_ID=
